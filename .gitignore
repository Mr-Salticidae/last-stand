# Godot 4+ specific ignores
.godot/
/android/

# Build artifacts (Godot export outputs at project root)
*.exe
*.pck

# 文档导出产物（PDF 等生成物放仓库外 ../last-stand-build/，不入库占体积）
*.pdf

# Private / 运营素材 / 设计稿原始资料
# 后续转公开仓库前请确认这些目录不会被推送
private/

# Claude Code 本地配置
.claude/

# VSCode 本地配置（含本机 Godot 编辑器绝对路径，因人而异）
.vscode/

# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Editor temp
*.swp
*~
